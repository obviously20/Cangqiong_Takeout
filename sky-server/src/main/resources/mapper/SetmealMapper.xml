<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.SetmealMapper">
    <!-- 新增套餐，返回新增的套餐id -->
    <insert id="addSetmeal" useGeneratedKeys="true" keyProperty="id">
        insert into setmeal (id,category_id,description,image,name,price,status,create_time,update_time,create_user,update_user)
        values (#{id},#{categoryId},#{description},#{image},#{name},#{price},#{status},#{createTime},#{updateTime},#{createUser},#{updateUser})
    </insert>
</mapper>